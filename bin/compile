#!/usr/bin/env bash
# Clone the submodules listed in .gitmodules into the build dir.
# Heroku API / GitHub Sync builds get a tarball with no .git, so
# `git submodule update` can't work; this reads .gitmodules directly.
#
# Supported per-submodule keys: path, url, branch (optional), revision (optional).
set -euo pipefail

BUILD_DIR=$1
GITMODULES="$BUILD_DIR/.gitmodules"

if [ ! -f "$GITMODULES" ]; then
  echo "-----> No .gitmodules file found. Skipping."
  exit 0
fi

# With -z each entry is "submodule.<name>.path\n<path>\0" (names may contain spaces).
git config -z -f "$GITMODULES" --get-regexp '^submodule\..*\.path$' |
while IFS=$'\n' read -r -d '' key path; do
  name=${key#submodule.}
  name=${name%.path}
  get() { git config -f "$GITMODULES" --get "submodule.$name.$1" || true; }

  url=$(get url)
  branch=$(get branch)
  revision=$(get revision)
  dest="$BUILD_DIR/$path"

  echo "-----> Installing submodule $path${branch:+ ($branch)}"
  git clone -q --single-branch ${branch:+--branch "$branch"} "$url" "$dest"

  if [ -n "$revision" ]; then
    echo "       Setting submodule revision to $revision"
    git -C "$dest" reset -q --hard "$revision"
  fi

  rm -rf "$dest/.git"
done